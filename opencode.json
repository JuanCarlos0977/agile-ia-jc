{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5-coder:0.5b" : { "name": "Qwen2.5 Coder 500M" },
        "qwen2.5-coder:1.5b" : { "name": "Qwen2.5 Coder 1.5B" },
        "qwen2.5-coder:3b" : { "name": "Qwen2.5 Coder 3B" },
        "qwen2.5-coder:7b": { "name": "Qwen2.5 Coder 7B" },
        "deepseek-coder:1.3b": { "name": "DeepSeek Coder 1.3B" },
        "deepseek-coder:6.7b": { "name": "DeepSeek Coder 6.7B" }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless"],
      "enabled": true
    }
  }
}